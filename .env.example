# Server ports
BE_PORT=5000
FE_PORT=3000

# Frontend URL
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:5000

# PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=typeawaywriter

# Application environment
NODE_ENV=development

# JWT authentication
JWT_SECRET=your_jwt_secret_here

# Gmail (for sending verification and reset emails)
# Generate an App Password at: Google Account → Security → App Passwords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Admin account (optional)
# There is already a default admin account created in the database, but you can change the credentials below if you want to use a different admin account.
# ADMIN_EMAIL=admin@typeawaywriter.com
# ADMIN_PASSWORD=admin123
# ADMIN_USERNAME=admin
